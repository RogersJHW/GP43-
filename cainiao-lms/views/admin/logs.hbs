{{!-- Operation logs - searchable, filterable and paginated audit trail. --}}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="mb-1">Operation logs</h2>
    <p class="text-secondary mb-0">{{total}} {{#if (eq total 1)}}entry{{else}}entries{{/if}} · newest first</p>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" action="/admin/logs" class="row g-2 align-items-end">
      <div class="col-md-5">
        <label class="form-label" for="log-q">Search</label>
        <input id="log-q" type="search" name="q" class="form-control" value="{{filters.q}}" placeholder="User, action or detail">
      </div>
      <div class="col-md-4">
        <label class="form-label" for="log-action">Action</label>
        <select id="log-action" name="action" class="form-select">
          <option value="">All actions</option>
          {{#each actions}}
          <option value="{{this}}" {{selectedIf ../filters.action this}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filter</button>
        <a href="/admin/logs" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
      <thead>
        <tr>
          <th class="text-nowrap">Time</th>
          <th>Operator</th>
          <th>Action</th>
          <th>Detail</th>
        </tr>
      </thead>
      <tbody>
        {{#each logs}}
        <tr>
          <td class="text-nowrap small text-secondary">{{formatDate createdAt}}</td>
          <td>{{username}}</td>
          <td><span class="badge text-bg-light border font-monospace">{{action}}</span></td>
          <td>{{detail}}</td>
        </tr>
        {{else}}
        <tr>
          <td colspan="4" class="text-center text-secondary py-4">No log entries match this filter.</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#if total}}
  <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span class="text-secondary small">Page {{page}} of {{totalPages}}</span>
    <nav aria-label="Log pages">
      <ul class="pagination pagination-sm mb-0">
        {{#each pagination}}
        <li class="page-item {{#if active}}active{{/if}}">
          <a class="page-link" href="{{url}}">{{number}}</a>
        </li>
        {{/each}}
      </ul>
    </nav>
  </div>
  {{/if}}
</div>
