{{!-- Reports - admin analytics calculated on the server from packages.json. --}}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="mb-1">Reports</h2>
    <p class="text-secondary mb-0">Parcel volume and inbound traffic from the live data set.</p>
  </div>
  <span class="badge text-bg-light border">Last 7 days</span>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card metric-card h-100">
      <div class="card-body">
        <div class="metric-label">Total parcels</div>
        <div class="metric-value">{{totalPackages}}</div>
        <div class="text-secondary small">Records in packages.json</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card h-100">
      <div class="card-body">
        <div class="metric-label">Ready for pickup</div>
        <div class="metric-value">{{statusCounts.Notified}}</div>
        <div class="text-secondary small">Parcels in Notified status</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card h-100">
      <div class="card-body">
        <div class="metric-label">Total weight</div>
        <div class="metric-value">{{totalWeight}} <span class="fs-5">kg</span></div>
        <div class="text-secondary small">Rounded to two decimals</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card metric-card h-100">
      <div class="card-body">
        <div class="metric-label">Open exceptions</div>
        <div class="metric-value">{{statusCounts.Exception}}</div>
        <div class="text-secondary small">Parcels currently marked Exception</div>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">Daily inbound · last 7 Hong Kong calendar days</div>
  <div class="card-body">
    {{#if dailyInbound}}
    <!-- CHART: daily-inbound -->
    <div class="css-chart">
      {{#each dailyInbound}}
      <div class="chart-column">
        <div class="chart-value">{{count}}</div>
        <div class="chart-bar" style="height: {{height}}%"></div>
        <div class="chart-label">{{label}}</div>
      </div>
      {{/each}}
    </div>
    <p class="text-secondary small mb-0 mt-2">Bars are scaled to the busiest day. A short stub marks a day with no inbound parcels.</p>
    {{else}}
    <p class="text-secondary mb-0">No inbound data yet.</p>
    {{/if}}
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header">Parcels by status</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Status</th>
              <th class="text-end">Parcels</th>
            </tr>
          </thead>
          <tbody>
            {{#each statusCounts}}
            <tr>
              <td><span class="badge {{statusClass @key}}">{{@key}}</span></td>
              <td class="text-end fw-semibold">{{this}}</td>
            </tr>
            {{else}}
            <tr>
              <td colspan="2" class="text-center text-secondary py-3">No parcels yet.</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header">Parcels by type</div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Type</th>
              <th class="text-end">Parcels</th>
            </tr>
          </thead>
          <tbody>
            {{#each typeCounts}}
            <tr>
              <td>{{@key}}</td>
              <td class="text-end fw-semibold">{{this}}</td>
            </tr>
            {{else}}
            <tr>
              <td colspan="2" class="text-center text-secondary py-3">No parcels yet.</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
